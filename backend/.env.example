INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere!123
INITIAL_ADMIN_EMAIL=admin@manubhaigathiyawala.com

# Daily Outbound Message Guardrail Limit
DAILY_MESSAGE_SEND_LIMIT=500

# External Inactive Customers Feed URL
MANUBHAI_STORE_INACTIVE_FEED_URL=http://localhost:8000/api/mock-store-feed/inactive-customers
